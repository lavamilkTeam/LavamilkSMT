[Unit]
Description=SMT single application X11 session
After=systemd-user-sessions.service
Conflicts=getty@tty7.service
StartLimitIntervalSec=120
StartLimitBurst=5
ConditionPathIsExecutable=/opt/smt/panel/bin/smt-desktop
ConditionPathIsExecutable=/usr/bin/Xorg

[Service]
Type=simple
User=smt-kiosk
Group=smt-kiosk
SupplementaryGroups=video
PAMName=login
StateDirectory=smt-kiosk
WorkingDirectory=/var/lib/smt-kiosk
Environment=HOME=/var/lib/smt-kiosk
Environment=LANG=C.UTF-8
Environment=XDG_SESSION_TYPE=x11
Environment=XDG_SEAT=seat0
Environment=XDG_VTNR=7
Environment=GDK_BACKEND=x11
Environment=SMT_KIOSK_SOFTWARE_RENDERING=0
EnvironmentFile=-/etc/smt/kiosk.env
TTYPath=/dev/tty7
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
UtmpIdentifier=tty7
UtmpMode=user
ExecStart=/usr/bin/xinit /usr/bin/dbus-run-session /usr/local/libexec/smt-kiosk-session -- /usr/bin/Xorg :0 vt7 -keeptty -nolisten tcp -noreset
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=multi-user.target
